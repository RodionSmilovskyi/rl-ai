{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Test: Hardware Controller & Physics",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_hardware_controller.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Test: Angle Mode Batch",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_angle_mode_batch.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Test: HRL Wrapper Params",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_hrl_wrapper_params.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Test: Drone Render",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_drone_render.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Test: Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_inference.py",
            "console": "integratedTerminal",
            "args": [
                "--model-path",
                "${workspaceFolder}/trained_models/model_phase_4_final_sac.tflite",
                "--goal-alt",
                "0.8",
                "--render",
                "--max-steps",
                "24",
                "--locked-axes",
                "yaw"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Test: Angle Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_angle_mode.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Conversion",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_conversion.py",
            "console": "integratedTerminal",
            "args": [
                "--model-path",
                "${workspaceFolder}/trained_models/model_phase_4_final_sac.pt",
                "--output-path",
                "${workspaceFolder}/trained_models/model_phase_4_final_sac.tflite"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
